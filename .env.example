# Frontend API Keys (VITE_ prefix - accessible in React)
# Set VITE_EMAIL_SERVER_URL to your backend Vercel deployment URL (e.g., https://your-backend.vercel.app)
# Keep it blank/empty for local development or when deploying frontend + backend in the same project.
VITE_EMAIL_SERVER_URL=

# AI Providers (OpenRouter recommended - has free models)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_HF_TOKEN=your_huggingface_token_here

# Creator Data APIs
VITE_YOUTUBE_API_KEY=your_youtube_data_api_key_here
# Needed for Instagram oEmbed (Meta app access token)
VITE_INSTAGRAM_APP_ACCESS_TOKEN=your_instagram_app_access_token_here

# Phyllo & Zernio API Keys (Social API providers)
VITE_PHYLLO_CLIENT_ID=your_phyllo_client_id_here
VITE_PHYLLO_CLIENT_SECRET=your_phyllo_client_secret_here
VITE_ZERNIO_API_KEY=your_zernio_api_key_here

# Gemini AI (used for influencer recommendations when YouTube API fails or for other platforms)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Payment Integration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Supabase (client-safe values only)
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Backend API Keys (NO VITE_ prefix - server only)
# These should be set in Vercel environment variables
# ============================================

# Stripe Secret Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase server-side keys (for webhook server-side operations)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_SECRET_KEY=your_supabase_service_role_or_secret_key

# Platform Default SMTP (Nodemailer)
PLATFORM_SMTP_HOST=smtp.gmail.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=your-email@gmail.com
PLATFORM_SMTP_PASS=your-app-password
PLATFORM_SENDER_EMAIL=your-email@gmail.com
PLATFORM_SENDER_NAME=CollabFree
